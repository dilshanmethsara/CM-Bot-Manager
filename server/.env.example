# Server Configuration
PORT=3000
NODE_ENV=development

# Dashboard Password (bcrypt hash of the password)
# Generate with: npm run db:hash-password -- yourpassword
DASHBOARD_PASSWORD=$2b$10$YOUR_HASH_HERE

# Database
DATABASE_URL="file:./cloud-mint.db"

# Session Storage Path
SESSION_PATH=./sessions

# Socket.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:5173
